# ==============================================================================
# GNSS-KALMAN & TACTICAL TERMINAL .gitignore
# ==============================================================================

# Compiled binaries and build directories
build/
tests/build/
bin/
*.exe
*.o
*.obj
*.so
*.dll
*.dylib
*.pbm

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# Scratch & temporary development files
scratch/
web/logs/
*.log
diagnose_map.*

# Editor & OS artifacts
.vscode/
.idea/
*.suo
*.user
*.userosv
*.sln.docstates
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
